@model IEnumerable<De_Thi_Mau.Models.HangHoa>
@{
    ViewData["Title"] = "Home Page";
    //Layout = "~Views/Shared/_Layout.cshtml";
}
<div class="content">
    <div class="content_top">
        <div class="heading">
            <h3>Bùi Minh An</h3>
        </div>
        <div class="see">
            <p><a href="#">See all Products</a></p>
        </div>
        <div class="clear"></div>
    </div>

    <div id="main-product-list">
        <partial name="_HangHoaListPartial" model="Model"/>
    </div>

</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            $(".filter-loai").click(function(e) {
                e.preventDefault();

                // Lấy MaLoai từ thuộc tính data-id của thẻ <a> vừa bấm
                var maLoai = $(this).data("id");

                // Đổi màu nền đỏ (class active) sang mục menu vừa chọn
                $(".menu ul li").removeClass("active");
                $(this).parent("li").addClass("active");

                // Gọi AJAX lên HomeController/FilterByLoai
                $.ajax({
                    url: '@Url.Action("FilterByLoai", "Home")',
                    type: 'GET',
                    data: { maLoai: maLoai },
                    success: function(response) {
                        // Đổ dữ liệu HTML trả về vào vùng main-product-list
                        $("#main-product-list").html(response);
                    },
                    error: function() {
                        alert("Không thể tải danh sách sản phẩm!");
                    }
                });
            });
        });
    </script>
}

