@model De_Thi_Mau.Models.HangHoa

@{
    ViewData["Title"] = "Thêm Hàng Hóa Mới";

}

<div class="content" style="padding: 15px 0;">
    <h2 style="font-size: 18px; font-weight: bold;">Bùi Minh An</h2>
    <h3 style="font-size: 16px; margin-bottom: 10px;">Thêm Hàng Hóa Mới</h3>
    <hr />

    <form asp-action="Create" method="post" style="margin-top: 10px;">
        <div asp-validation-summary="ModelOnly" style="color: red;"></div>

        <div style="margin-bottom: 10px;">
            <label asp-for="MaLoai">MaLoai</label><br />
            @await Component.InvokeAsync("LoaiHang", new { viewName = "Dropdown", selectedId = Model?.MaLoai })
            <span asp-validation-for="MaLoai" style="color: red; display: block;"></span>
        </div>

        <div style="margin-bottom: 10px;">
            <label asp-for="TenHang">TenHang</label><br />
            <input asp-for="TenHang" style="padding: 3px; width: 200px;" />
            <span asp-validation-for="TenHang" style="color: red; display: block;"></span>
        </div>

        <div style="margin-bottom: 10px;">
            <label asp-for="Gia">Gia</label><br />
            <input asp-for="Gia" style="padding: 3px; width: 200px;" />
            <span asp-validation-for="Gia" style="color: red; display: block;"></span>
        </div>

        <div style="margin-bottom: 10px;">
            <label asp-for="Anh">Anh</label><br />
            <input asp-for="Anh" style="padding: 3px; width: 200px;" />
            <span asp-validation-for="Anh" style="color: red; display: block;"></span>
        </div>

        <button type="submit" style="padding: 3px 10px;">Create</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}